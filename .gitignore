.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# Runtime state — never committed.
# Every .env variant is ignored and only the example is allowed back in,
# so a new .env.production cannot be added by accident.
.env
.env.*
!.env.example
books.db
books.db-*
*.log
*.log.*
cover_cache/
author_cache/

# Keys and certificates, wherever they land
*.key
*.crt
*.pem
*.p12

# Local library data — books, covers and the index never leave the machine
*.epub
*.azw3
*.mobi

# Node / Playwright
node_modules/
test-results/
playwright-report/

# Playwright fixture library — regenerated, never committed
.test-library/
.env.test

# Run state — pidfile and captured stdout
.run/
library-manifest.json

# Claude Code's per-machine state: tool permissions granted on this Mac
# and a scheduler lock. Machine-local by definition, so not shared. A
# .claude/settings.json meant for everyone would still be committed.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Coverage's data file: a binary full of absolute paths.
.coverage
htmlcov/

# One-off duplicate-file report and its deletion script. They list real
# paths out of LIBRARY_ROOT, so they are local working files, not repo
# content — this repo is meant to be publishable.
duplicate-files.md
delete-duplicates.sh
