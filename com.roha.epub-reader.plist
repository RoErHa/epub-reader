<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for the epub-reader service.

  Install:
    cp com.roha.epub-reader.plist ~/Library/LaunchAgents/
    # replace /path/to/epub-reader below with the real path first
    launchctl load ~/Library/LaunchAgents/com.roha.epub-reader.plist

  All configuration lives in .env — nothing is passed as an argument here.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.roha.epub-reader</string>

    <key>WorkingDirectory</key>
    <string>/path/to/epub-reader</string>

    <key>ProgramArguments</key>
    <array>
        <string>/path/to/epub-reader/.venv/bin/python</string>
        <string>/path/to/epub-reader/epub_gateway.py</string>
        <string>--env</string>
        <string>/path/to/epub-reader/.env</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/path/to/epub-reader/gateway.log</string>

    <key>StandardErrorPath</key>
    <string>/path/to/epub-reader/gateway.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
