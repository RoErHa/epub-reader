# epub-reader configuration.
#
# THIS FILE IS THE ONLY PLACE CONFIGURATION LIVES.
# Every secret, password, API key, port and path belongs here — never
# hardcoded in a module, never in a second config file. Copy to `.env`
# and fill in. `.env` is gitignored; this example never holds real values.

# ── Network ───────────────────────────────────────────────────────────
# 8770 is clear of dlna-gateway (8765) and localfs (8200).
EPUB_PORT=8770

# Which addresses to answer on. Loopback by default, because there is NO
# AUTHENTICATION here: the service acts for anyone who can reach the port,
# and `run.sh forget --apply` has an HTTP equivalent. Widen it deliberately
# and only onto a network you trust — a tailnet address, or 0.0.0.0 if the
# machine is not reachable from anywhere you would mind.
EPUB_BIND=127.0.0.1

# ── Library ───────────────────────────────────────────────────────────
# Absolute path to the folder holding your books. Read-only: the service
# never moves, renames or writes to anything under here.
LIBRARY_ROOT=/Users/you/Books

# SQLite database. Relative paths resolve against the project directory.
DB_PATH=books.db

# Where extracted covers and author photos are cached.
COVER_CACHE=cover_cache

# ── TLS ───────────────────────────────────────────────────────────────
# Tailnet hostname Tailscale issued the cert for, e.g.
#   ronsmacmini.tailXXXXX.ts.net
# Leave blank to serve plain HTTP on the bind address.
TAILSCALE_CERT_HOST=

# Where that certificate actually lives. If left blank, the service looks
# for <TAILSCALE_CERT_HOST>.crt and .key next to this file. Nothing is
# guessed beyond that: a missing certificate is reported, not improvised.
TLS_CERT_FILE=
TLS_KEY_FILE=

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=gateway.log

# ── Metadata providers (M5) ───────────────────────────────────────────
# Open Library asks that clients identify themselves; used as User-Agent.
# Open Library allows 1 request/second anonymously and 3/second to a client
# that identifies itself with an application name and a contact address — the
# address below is what does that, so set it. Their APIs are explicitly not a
# bulk data backend; for bulk work they ask you to use the monthly data dumps.
#   https://openlibrary.org/developers/api
OPENLIBRARY_CONTACT_EMAIL=
# Optional — Google Books works unauthenticated but is rate limited.
GOOGLE_BOOKS_API_KEY=
HARDCOVER_API_TOKEN=
ISBNDB_API_KEY=

# Requests per second to metadata providers. Capped at 3 — Open Library's
# published ceiling for an identified client. The default of 2 leaves them
# room, and every answer is cached in the database so an author is only ever
# looked up once.
PROVIDER_MAX_RPS=2

# Seconds between requests while fetching cover art (`run.sh covers --online`).
# That sweep asks about several hundred books in one sitting, which is closer
# to bulk than to browsing however politely it is paced — so it gets its own,
# far slower clock and walks the library overnight rather than in ten minutes.
COVER_FETCH_INTERVAL=60

# Whether `run.sh start|restart` also checks authors and titles after scanning
# for new books. Off by default: it reaches a provider, which is not something
# to do on someone's behalf without being asked. `run.sh repair` does it on
# demand, and `run.sh repair --apply` is what changes anything.
# Whether a scan also reads the filenames it just found — author,
# series and title (§8.13a), a co-author freed from a title (§8.13b),
# the scanner's notes taken off (§8.13d). ON unless you turn it off:
# these reach no provider and cost nobody a request, and what the file
# said is kept in `file_title`, so nothing here is one-way.
TIDY_ON_SCAN=true

# Whether a scan also runs the three passes that ASK Open Library.
# Off unless asked for: reaching a provider on every restart is not
# something to decide for somebody.
REPAIR_ON_SCAN=false

# ── macOS only ───────────────────────────────────────────────────────
# Which LaunchAgent `./run.sh` drives, and the Label inside the plist.
# `com.example` is the domain reserved for documentation (RFC 2606) —
# change both this and the plist to a domain you own, or leave it be.
LAUNCHD_LABEL=com.example.epub-reader
